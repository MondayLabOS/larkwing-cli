{
  "name": "larkwing-cli",
  "version": "0.1.0",
  "description": "Natural-language workflow layer on top of lark-cli.",
  "keywords": [
    "agent-skills",
    "feishu",
    "lark",
    "templates",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MondayLabOS/larkwing-cli.git"
  },
  "homepage": "https://github.com/MondayLabOS/larkwing-cli#readme",
  "bugs": {
    "url": "https://github.com/MondayLabOS/larkwing-cli/issues"
  },
  "type": "module",
  "bin": {
    "larkwing": "./bin/larkwing.js"
  },
  "files": [
    "bin/",
    "dist/",
    "workflows/",
    "templates/",
    "skills/",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "PERSONAL_MEMORY.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node ./bin/larkwing.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@larksuite/cli": "^1.0.85"
  }
}
